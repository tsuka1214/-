rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者専用設定 (LINE WORKS連携設定: settings/lineworks)
    match /settings/lineworks {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
