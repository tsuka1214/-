{
  "entities": {
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for club activities",
      "type": "object",
      "properties": {
        "memberName": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "section": { "type": "string" },
        "part": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["memberName", "date", "type"]
    },
    "Member": {
      "title": "Member",
      "description": "Club member record",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "role": { "type": "string" },
        "section": { "type": "string" },
        "part": { "type": "string" }
      },
      "required": ["name"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App settings configuration",
      "type": "object",
      "properties": {
        "clubName": { "type": "string" },
        "adminPasscode": { "type": "string" }
      }
    },
    "LineWorksSettings": {
      "title": "LineWorksSettings",
      "description": "LINE WORKS integration credentials and settings",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "serviceAccount": { "type": "string" },
        "privateKey": { "type": "string" },
        "botId": { "type": "string" },
        "channelId": { "type": "string" },
        "serverId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "mode": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "sendDailySummary": { "type": "boolean" },
        "sendTardyAlert": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      }
    },
    "ClubKeyStatus": {
      "title": "ClubKeyStatus",
      "description": "Lock status for club keys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reporterName": { "type": "string" },
        "section": { "type": "string" },
        "part": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "ClubKeyLog": {
      "title": "ClubKeyLog",
      "description": "Historical log of key lock operations",
      "type": "object",
      "properties": {
        "keyId": { "type": "string" },
        "status": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reporterName": { "type": "string" },
        "section": { "type": "string" },
        "part": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/attendances/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance collection"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Members roster collection"
    },
    "/config/{configId}": {
      "schema": "Settings",
      "description": "Configuration collection"
    },
    "/settings/{settingId}": {
      "schema": "LineWorksSettings",
      "description": "Admin settings including LINE WORKS configuration"
    },
    "/key_status/{keyId}": {
      "schema": "ClubKeyStatus",
      "description": "Key status collection for key1 and key2"
    },
    "/key_logs/{logId}": {
      "schema": "ClubKeyLog",
      "description": "Key status historical activity logs"
    }
  }
}
